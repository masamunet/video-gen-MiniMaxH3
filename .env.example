# このファイルをコピーして .env を作り、実際のキーを設定する。
# .env は .gitignore 済みなのでコミットされない。

# RunPod Serverless の API キー (rpa_...)。RunPod をバックエンドに選ぶ場合のみ必要。
RUNPOD_API_KEY=

# ブラウザの初期設定に使う接続先。PUBLIC_ プレフィックスの値はクライアントへ公開されるため、
# API キーなどの秘密情報は絶対に書かない。既存ブラウザの保存済み設定 (localStorage) があれば
# そちらが優先される。
PUBLIC_COMFYUI_HOST=http://localhost:8000/
PUBLIC_RUNPOD_ENDPOINT_ID=
